{
  "expo": {
    "name": "ProjectDay",
    "slug": "projectday",
    "scheme": "projectday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.projectday.bouldering"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ProjectDay to access your photos to set a profile avatar."
        }
      ],
      "./app.plugin",
      "expo-video",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "3d6b4518-e4bb-499d-8680-f08244cef321"
      }
    }
  }
}
